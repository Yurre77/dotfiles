{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": " "
  },
  "modules": [
    {
        "type": "title",
        "key": "╭─ User            ",
        "format": "{user-name}@{host-name}",
        "keyColor": "blue"
    },
    {
        "type": "os",
        "key": "├─{icon} Distro          ",
        "keyColor": "blue"
    },
    {
        "type": "kernel",
        "key": "├─ Kernel          ",
        "keyColor": "blue"
    },
    {
        "type": "uptime",
        "key": "├─󰅐 Uptime          ",
        "keyColor": "blue"
    },
    {
        "type": "packages",
        "key": "├─󰏖 Packages        ",
        "keyColor": "blue"
    },
    {
        "type": "localip",
        "key": "╰─󰩟 Local IP        ",
        "compact": true,
        "keyColor": "blue"
    },
    "break",

    {
        "type": "host",
        "key": "╭─󰌢 Host            ",
        "keyColor": "cyan"
    },
    {
        "type": "cpu",
        "key": "├─󰻠 CPU             ",
        "keyColor": "cyan"
    },
    {
        "type": "gpu",
        "key": "├─󰍛 GPU             ",
        "keyColor": "cyan"
    },
    {
        "type": "disk",
        "key": "├─ Disk            ",
        "keyColor": "cyan"
    },
    {
        "type": "memory",
        "key": "├─󰑭 Memory          ",
        "keyColor": "cyan"
    },
    {
        "type": "swap",
        "key": "├─󰓡 Swap            ",
        "keyColor": "cyan"
    },
    {
        "type": "display",
        "key": "├─󰍹 Display         ",
        "keyColor": "cyan"
    },
    {
        "type": "battery",
        "key": "├─ Battery         ",
        "keyColor": "cyan"
    },
    {
        "type": "poweradapter",
        "key": "├─ Power           ",
        "keyColor": "cyan"
    },
    {
        "type": "sound",
        "key": "╰─ Sound           ",
        "keyColor": "cyan"
    },
    "break",

    {
        "type": "shell",
        "key": "╭─ Shell           ",
        "keyColor": "green"
    },
    {
        "type": "terminal",
        "key": "├─ Terminal        ",
        "keyColor": "green"
    },
    {
        "type": "terminalfont",
        "key": "├─ Terminal Font   ",
        "keyColor": "green"
    },
    {
        "type": "lm",
        "key": "├─󰧨 LM              ",
        "keyColor": "green"
    },
    {
        "type": "de",
        "key": "├─ DE              ",
        "keyColor": "green"
    },
    {
        "type": "wm",
        "key": "├─ WM              ",
        "keyColor": "green"
    },
    {
        "type": "theme",
        "key": "├─󰉼 Theme           ",
        "keyColor": "green"
    },
    {
        "type": "icons",
        "key": "╰─󰀻 Icons           ",
        "keyColor": "green"
    },
    "break",
    
    {
        "type": "colors",
        "symbol": "circle"
    }
  ]
}
